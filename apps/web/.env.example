# ─────────────────────────────────────────────────────────────
# OpenField environment variables
# Copy this file to `.env.local` and fill in the values you need.
# Everything here is OPTIONAL — the app runs as a local-first editor
# when these are left blank. Features that need infrastructure fail
# with a clear message rather than calling any third-party service.
# ─────────────────────────────────────────────────────────────

# Supabase — auth, cloud project storage, analytics & feedback.
# Create a project at https://supabase.com, then copy the Project URL
# and the anon/public key from Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog Analytics (optional — analytics also logs to Supabase when set above)
# Get your keys at https://posthog.com
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# ─────────────────────────────────────────────────────────────
# OpenField-owned infrastructure (provision these yourself).
# These replaced the upstream OpenReel endpoints. There is NO fallback:
# leave blank and the specific feature is unavailable (fails clearly),
# never calling OpenReel infrastructure.
# ─────────────────────────────────────────────────────────────

# AI Captions — host serving the Whisper ONNX models (Transformers.js).
# Mirror the onnx-community Whisper models (whisper-tiny + whisper-large-v3-turbo)
# to your own R2/CDN bucket and point here (must end with a trailing slash).
#   e.g. https://models.yourdomain.com/models/
VITE_WHISPER_MODEL_URL=

# Video Stabilization — base URL serving the ffmpeg-vidstab core builds.
# Expected layout: <base>/mt/ffmpeg-core.* and <base>/st/ffmpeg-core.*
#   e.g. https://media.yourdomain.com/ffmpeg-vidstab
VITE_VIDSTAB_URL=

# Cloud sharing + cloud templates (optional). Your own Worker/API base URL.
# Leave blank to disable cloud sharing/templates (local editing still works).
#   e.g. https://api.yourdomain.com
VITE_OPENFIELD_CLOUD_URL=
